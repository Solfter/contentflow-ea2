# Copiar este archivo como .env y completar con los datos reales (el .env NO se sube al repositorio)
# String de conexión del usuario de aplicación (rol readWrite sobre la base ev-2-bd-nosql)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
MONGODB_DB=ev-2-bd-nosql

# Configuración de la API
LOG_LEVEL=INFO
LOG_FILE=logs/api.log
